/tools/rea-release
/.stversions
.env
.env.*
*.pem
*.key
id_rsa
id_ed25519
credentials.json
secrets.json
notify.json
__pycache__
*.pyc
*.log
(?d).DS_Store
(?d)Thumbs.db
(?d)desktop.ini
